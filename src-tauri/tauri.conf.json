{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OptiClean",
  "version": "0.2.5",
  "identifier": "com.opticlean.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "OptiClean", "width": 1380, "height": 880, "minWidth": 1380, "maxWidth": 1380, "minHeight": 880, "maxHeight": 880, "center": true, "resizable": true, "maximizable": false, "decorations": false, "visible": false, "backgroundColor": "#000000" }
    ],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}

