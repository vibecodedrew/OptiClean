{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OptiClean",
  "version": "0.2.4",
  "identifier": "com.opticlean.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "OptiClean", "width": 1180, "height": 780, "minWidth": 920, "minHeight": 600, "visible": false, "backgroundColor": "#000000" }
    ],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
